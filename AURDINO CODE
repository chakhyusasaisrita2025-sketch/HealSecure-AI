// ======================================================
// COMMAND HANDLER
// ======================================================

void handleCommand()
{
  if (!Serial.available())
    return;

  char command =
    Serial.read();


  if (command == '\n' ||
      command == '\r' ||
      command == ' ')
  {
    return;
  }


  if (command >= '0' &&
      command <= '9')
  {
    currentMode =
      command - '0';

    setDemoValues(currentMode);

    Serial.println();
    Serial.println(F("DRUG DEMO SELECTED"));
  }


  else if (command == 'T' ||
           command == 't')
  {
    currentMode = 10;

    setDemoValues(10);

    Serial.println(F("TRIPLE ANTIBIOTIC"));
  }


  else if (command == 'F' ||
           command == 'f')
  {
    currentMode = 11;

    setDemoValues(11);

    Serial.println(F("FENTANYL + CAFFEINE"));
  }


  else if (command == 'A' ||
           command == 'a')
  {
    currentMode = 12;

    Serial.println(F("AUTO MODE"));
  }


  else if (command == 'V' ||
           command == 'v')
  {
    currentMode = 13;

    Serial.println();
    Serial.println(F("************************"));
    Serial.println(F("      LIVE MODE"));
    Serial.println(F("************************"));
  }


  else if (command == '?')
  {
    showMenu();
  }
}


// ======================================================
// SETUP
// ======================================================

void setup()
{
  Serial.begin(9600);

  Wire.begin();


  // 74HC08

  pinMode(
    AND_A,
    OUTPUT
  );

  pinMode(
    AND_B,
    OUTPUT
  );

  pinMode(
    AND_OUT,
    INPUT
  );


  digitalWrite(
    AND_A,
    LOW
  );

  digitalWrite(
    AND_B,
    LOW
  );


  // LED

  pinMode(
    LED_PIN,
    OUTPUT
  );

  digitalWrite(
    LED_PIN,
    LOW
  );


  // SERVO

  riskServo.attach(
    SERVO_PIN
  );

  riskServo.write(0);


  // LCD

  lcdPresentFlag =
    deviceFound(LCD_ADDR);


  if (lcdPresentFlag)
  {
    lcdInit();

    lcdClear();

    lcdCursor(0, 0);
    lcdText("HEALSECURE AI");

    lcdCursor(0, 1);
    lcdText("NICU DEMO");

    delay(1500);
  }


  // RGB

  rgbPresentFlag =
    deviceFound(RGB_ADDR);


  if (rgbPresentFlag)
  {
    rgbInit();

    Serial.println(
      F("RGB SENSOR FOUND")
    );
  }
  else
  {
    Serial.println(
      F("RGB SENSOR NOT FOUND")
    );
  }


  // Calibration

  calibrate();


  // Start LOW

  currentMode = 0;

  setDemoValues(0);


  Serial.println();
  Serial.println(
    F("HEALSECURE AI READY")
  );


  showMenu();
}


// ======================================================
// LOOP
// ======================================================

void loop()
{
  handleCommand();


  // -----------------------------------------------
  // LIVE / AUTO
  // -----------------------------------------------

  if (currentMode == 12 ||
      currentMode == 13)
  {
    processLive();
  }


  // -----------------------------------------------
  // GET RISK
  // -----------------------------------------------

  byte risk = 0;


  if (currentMode == 12 ||
      currentMode == 13)
  {
    risk =
      getLiveRisk();
  }
  else
  {
    if (currentMode == 0)
      risk = 0;

    else if (
      currentMode == 4 ||
      currentMode >= 7
    )
      risk = 2;

    else
      risk = 1;
  }


  // -----------------------------------------------
  // ACTUATORS
  // -----------------------------------------------

  setActuators(risk);


  // -----------------------------------------------
  // SERIAL LIVE
  // -----------------------------------------------

  if (
    currentMode == 12 ||
    currentMode == 13
  )
  {
    if (millis() - serialTimer >= 500)
    {
      serialTimer = millis();

      Serial.print(F("GSR="));
      Serial.print(gsrValue);

      Serial.print(F(" GAS="));
      Serial.print(gasValue);

      Serial.print(F(" R="));
      Serial.print(redValue);

      Serial.print(F(" G="));
      Serial.print(greenValue);

      Serial.print(F(" B="));
      Serial.print(blueValue);

      Serial.print(F(" RISK="));

      if (risk == 0)
        Serial.println(F("LOW"));

      else if (risk == 1)
        Serial.println(F("MEDIUM"));

      else
        Serial.println(F("HIGH"));
    }
  }


  // -----------------------------------------------
  // LCD
  // -----------------------------------------------

  unsigned long interval;

  if (currentMode == 13)
    interval = 500;
  else
    interval = 1500;


  if (
    millis() - lcdTimer >= interval
  )
  {
    lcdTimer = millis();


    if (lcdPresentFlag)
    {
      if (lcdPage == 0)
        lcdRiskPage(risk);

      else if (lcdPage == 1)
        lcdSensorPage();

      else if (lcdPage == 2)
        lcdInfoPage();

      else
        lcdAlertPage(risk);


      lcdPage++;


      if (lcdPage > 3)
        lcdPage = 0;
    }
  }


  delay(5);
}
