// ======================================================
// LIVE SENSOR PROCESSING
// ======================================================

void processLive()
{
  gsrValue = analogRead(GSR_PIN);

  gasValue = analogRead(GAS_PIN);

  if (rgbPresentFlag)
    readRGB();

  gsrAbnormal = gsrDetected();

  gasAbnormal = gasDetected();

  rgbAbnormal = redDetected();


  // Send real anomalies to 74HC08

  digitalWrite(
    AND_A,
    gsrAbnormal ? HIGH : LOW
  );

  digitalWrite(
    AND_B,
    gasAbnormal ? HIGH : LOW
  );

  delayMicroseconds(100);

  andHigh =
    digitalRead(AND_OUT);


  Serial.println();

  Serial.print(F("GSR: "));
  Serial.println(gsrValue);

  Serial.print(F("GAS: "));
  Serial.println(gasValue);

  Serial.print(F("RGB R: "));
  Serial.println(redValue);

  Serial.print(F("RGB G: "));
  Serial.println(greenValue);

  Serial.print(F("RGB B: "));
  Serial.println(blueValue);

  Serial.print(F("RGB RED: "));
  Serial.println(
    rgbAbnormal ? F("YES") : F("NO")
  );

  Serial.print(F("74HC08: "));
  Serial.println(
    andHigh ? F("HIGH") : F("LOW")
  );
}


// ======================================================
// LIVE RISK
//
// 0 = LOW
// 1 = MEDIUM
// 2 = HIGH
// ======================================================

byte getLiveRisk()
{
  byte abnormalCount = 0;

  if (gsrAbnormal)
    abnormalCount++;

  if (gasAbnormal)
    abnormalCount++;

  if (rgbAbnormal)
    abnormalCount++;


  if (andHigh || abnormalCount >= 2)
    return 2;

  if (abnormalCount == 1)
    return 1;

  return 0;
}


// ======================================================
// SERVO LOW
// ======================================================

void servoLow()
{
  servoPosition = 0;
  servoDirection = 1;

  riskServo.write(0);
}


// ======================================================
// SERVO MEDIUM
// ======================================================

void servoMedium()
{
  if (millis() - servoTimer >= 20)
  {
    servoTimer = millis();

    servoPosition +=
      servoDirection * 5;


    if (servoPosition >= 90)
    {
      servoPosition = 90;
      servoDirection = -1;
    }


    if (servoPosition <= 20)
    {
      servoPosition = 20;
      servoDirection = 1;
    }


    riskServo.write(servoPosition);
  }
}


// ======================================================
// SERVO HIGH
// ======================================================

void servoHigh()
{
  if (millis() - servoTimer >= 8)
  {
    servoTimer = millis();

    servoPosition +=
      servoDirection * 8;


    if (servoPosition >= 120)
    {
      servoPosition = 120;
      servoDirection = -1;
    }


    if (servoPosition <= 20)
    {
      servoPosition = 20;
      servoDirection = 1;
    }


    riskServo.write(servoPosition);
  }
}


// ======================================================
// LED
// ======================================================

void ledLow()
{
  digitalWrite(
    LED_PIN,
    LOW
  );
}


void ledMedium()
{
  if (millis() - ledTimer >= 250)
  {
    ledTimer = millis();

    ledState = !ledState;

    digitalWrite(
      LED_PIN,
      ledState
    );
  }
}


void ledHigh()
{
  digitalWrite(
    LED_PIN,
    HIGH
  );
}


// ======================================================
// ACTUATOR
// ======================================================

void setActuators(byte risk)
{
  if (risk == 2)
  {
    ledHigh();
    servoHigh();
  }

  else if (risk == 1)
  {
    ledMedium();
    servoMedium();
  }

  else
  {
    ledLow();
    servoLow();
  }
}


