// ======================================================

void lcdWrite(byte data)
{
  Wire.beginTransmission(LCD_ADDR);
  Wire.write(data);
  Wire.endTransmission();
}


// ======================================================
// LCD COMMAND
// ======================================================

void lcdCommand(byte command)
{
  byte highNibble = command & 0xF0;
  byte lowNibble = (command << 4) & 0xF0;

  lcdWrite(highNibble | 0x0C);
  lcdWrite(highNibble | 0x08);

  lcdWrite(lowNibble | 0x0C);
  lcdWrite(lowNibble | 0x08);
}


// ======================================================
// LCD CHARACTER
// ======================================================

void lcdChar(char c)
{
  byte highNibble = c & 0xF0;
  byte lowNibble = (c << 4) & 0xF0;

  lcdWrite(highNibble | 0x0D);
  lcdWrite(highNibble | 0x09);

  lcdWrite(lowNibble | 0x0D);
  lcdWrite(lowNibble | 0x09);
}


// ======================================================
// LCD TEXT
// ======================================================

void lcdText(const char *text)
{
  while (*text)
  {
    lcdChar(*text);
    text++;
  }
}


// ======================================================
// LCD NUMBER
// ======================================================

void lcdNumber(int value)
{
  char buffer[10];

  itoa(value, buffer, 10);

  lcdText(buffer);
}


// ======================================================
// LCD TEMPERATURE
// ======================================================

void lcdTemperature(int value)
{
  lcdNumber(value / 10);
  lcdChar('.');
  lcdNumber(abs(value % 10));
  lcdChar('C');
}


// ======================================================
// LCD PH
// ======================================================

void lcdPH(int value)
{
  lcdNumber(value / 100);
  lcdChar('.');
  lcdNumber((value % 100) / 10);
  lcdNumber(value % 10);
}


// ======================================================
// LCD CLEAR
// ======================================================

void lcdClear()
{
  lcdCommand(0x01);
  delay(2);
}


// ======================================================
// LCD CURSOR
// ======================================================

void lcdCursor(byte column, byte row)
{
  byte address;

  if (row == 0)
    address = column;
  else
    address = 0x40 + column;

  lcdCommand(0x80 | address);
}


// ======================================================
// LCD INIT
// ======================================================

void lcdInit()
{
  delay(50);

  lcdCommand(0x33);
  lcdCommand(0x32);
  lcdCommand(0x28);
  lcdCommand(0x0C);
  lcdCommand(0x06);
  lcdCommand(0x01);

  delay(10);
}


// ======================================================
// I2C CHECK
// ======================================================

bool deviceFound(byte address)
{
  Wire.beginTransmission(address);
  return Wire.endTransmission() == 0;
}


// ======================================================
// RGB WRITE
// ======================================================

void rgbWrite(byte reg, byte value)
{
  Wire.beginTransmission(RGB_ADDR);

  Wire.write(0x80 | reg);
  Wire.write(value);

  Wire.endTransmission();
}


// ======================================================
// RGB READ
// ======================================================

uint16_t rgbRead(byte reg)
{
  Wire.beginTransmission(RGB_ADDR);

  Wire.write(0xA0 | reg);

  Wire.endTransmission();

  Wire.requestFrom(RGB_ADDR, (byte)2);

  if (Wire.available() < 2)
    return 0;

  byte lowByte = Wire.read();
  byte highByte = Wire.read();

  return ((uint16_t)highByte << 8) | lowByte;
}


// ======================================================
// RGB INIT
// ======================================================

void rgbInit()
{
  rgbWrite(0x00, 0x01);

  delay(5);

  rgbWrite(0x00, 0x03);

  rgbWrite(0x01, 0xEB);

  rgbWrite(0x0F, 0x01);

  delay(60);
}


// ======================================================
// READ RGB
// ======================================================

void readRGB()
{
  clearValue = rgbRead(0x14);
  redValue = rgbRead(0x16);
  greenValue = rgbRead(0x18);
  blueValue = rgbRead(0x1A);
}


// ======================================================
// RGB RED DETECTION
// ======================================================

bool redDetected()
{
  if (clearValue < 30)
    return false;

  if (redValue < 80)
    return false;

  if (redValue > (greenValue * 1.30) &&
      redValue > (blueValue * 1.30))
  {
    return true;
  }

  return false;
}


// ======================================================
// GSR ANOMALY
// ======================================================

bool gsrDetected()
{
  if (gsrBaseline < 5)
    return false;

  long difference =
    abs(gsrValue - gsrBaseline);

  return difference >=
         (gsrBaseline * 20L / 100L);
}


// ======================================================
// GAS ANOMALY
// ======================================================

bool gasDetected()
{
  if (gasBaseline < 5)
    return false;

  long difference =
    abs(gasValue - gasBaseline);

  return difference >=
         (gasBaseline * 20L / 100L);
}


// ======================================================
// COLOR
// ======================================================

byte getColor()
{
  if (clearValue < 10)
    return 0;

  if (redValue > greenValue * 1.30 &&
      redValue > blueValue * 1.30)
    return 1;

  if (greenValue > redValue * 1.20 &&
      greenValue > blueValue * 1.20)
    return 2;

  if (blueValue > redValue * 1.20 &&
      blueValue > greenValue * 1.20)
    return 3;

  return 4;
}


// ======================================================
// CALIBRATION
// ======================================================

void calibrate()
{
  Serial.println(F("CALIBRATING..."));
  Serial.println(F("Keep sensors normal."));

  if (lcdPresentFlag)
  {
    lcdClear();

    lcdCursor(0, 0);
    lcdText("CALIBRATING");

    lcdCursor(0, 1);
    lcdText("KEEP NORMAL");
  }

  delay(2000);

  long gsrTotal = 0;
  long gasTotal = 0;

  for (byte i = 0; i < 20; i++)
  {
    gsrTotal += analogRead(GSR_PIN);
    gasTotal += analogRead(GAS_PIN);

    delay(50);
  }

  gsrBaseline = gsrTotal / 20;
  gasBaseline = gasTotal / 20;

  Serial.print(F("GSR BASELINE: "));
  Serial.println(gsrBaseline);

  Serial.print(F("GAS BASELINE: "));
  Serial.println(gasBaseline);
}


